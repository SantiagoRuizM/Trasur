{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "analyze": "vite build",
        "format": "npx prettier --config ./.prettierrc.json --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"src/*.{js,jsx,ts,tsx,json,css,scss,md}\" package.json",
        "lint": "eslint . --fix",
        "getautotypes": "openapi-ts",
        "typecheck": "tsc -b",
        "precommit": "npm run getautotypes && npm run lint && npm run format && npm run typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "preview": "vite preview",
        "ci_prettier": "npx prettier --config ./.prettierrc.json --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"src/*.{js,jsx,ts,tsx,json,css,scss,md}\" package.json",
        "ci_typecheck": "tsc -b",
        "ci_lint": "eslint .",
        "ci_build": "tsc -b && vite build",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@hookform/resolvers": "^5.4.0",
        "@tailwindcss/vite": "^4.2.2",
        "@tanstack/react-query": "^5.99.0",
        "@tanstack/react-router": "^1.168.22",
        "@tanstack/react-router-devtools": "^1.166.13",
        "axios": "^1.15.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.3.6",
        "jwt-decode": "^4.0.0",
        "lucide-react": "^1.8.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-hook-form": "^7.77.0",
        "react-i18next": "^17.0.11",
        "shadcn": "^4.3.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.2",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@chromatic-com/storybook": "latest",
        "@eslint/js": "^9.39.4",
        "@hey-api/openapi-ts": "0.96.1",
        "@playwright/test": "^1.62.1",
        "@rolldown/plugin-babel": "^0.2.2",
        "@storybook/addon-a11y": "^10.5.8",
        "@storybook/addon-docs": "^10.5.8",
        "@storybook/addon-mcp": "latest",
        "@storybook/tanstack-react": "^10.5.8",
        "@tanstack/router-plugin": "^1.167.22",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "4.1.9",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-storybook": "^10.5.8",
        "globals": "^17.4.0",
        "jsdom": "^29.1.1",
        "playwright": "latest",
        "prettier": "3.8.3",
        "rollup-plugin-visualizer": "^7.1.1",
        "storybook": "^10.5.8",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.3.4",
        "vitest": "^4.1.9"
    }
}
